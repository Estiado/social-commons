# 构建期公开配置；留空时使用静态阅读模式。在 Cloudflare Pages 构建环境也要配置。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 后端运行期配置：Cloudflare Pages > Settings > Variables and Secrets。
# service role 必须作为服务端 Secret 保存，禁止使用 VITE_ 前缀。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 可选：覆盖提取接口地址（Netlify 已配置同一路径重写，不必修改）
VITE_ARTICLE_API_PATH=/api/extract-article

# 可选：英文逗号分隔的来源域名白名单；不填则使用代码中列出的媒体。
# ARTICLE_ALLOWED_HOSTS=thepaper.cn,people.com.cn,gmw.cn
