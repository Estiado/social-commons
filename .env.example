# 构建期公开配置；留空时使用静态阅读模式。在 Cloudflare Pages 构建环境也要配置。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local pilot stays usable without email. Enable only after SMTP/account acceptance.
VITE_READING_CLOUD_ENABLED=false

# 文章提取现在为无状态接口，不需要数据库 service role 密钥。

# 可选：英文逗号分隔的来源域名白名单；不填则使用代码中列出的媒体。
# ARTICLE_ALLOWED_HOSTS=thepaper.cn,people.com.cn,gmw.cn
